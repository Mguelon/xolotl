# comfy-api-proxy in front of your ComfyUI (see README)
COMFY_BASE_URL=http://127.0.0.1:8192
# Only if your proxy is configured with a bearer token
COMFY_API_KEY=
# ComfyUI itself: the take's step and the character's description are read there, since the proxy relays neither
COMFYUI_URL=http://127.0.0.1:8188
# Origins allowed to use the dev server besides localhost (comma-separated), e.g. your LAN IP
XOLOTL_DEV_ORIGINS=
